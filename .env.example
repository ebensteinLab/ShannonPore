# Copy to .env and `source .env` (or use direnv) before running.
# Both variables are optional — if unset, shannonpore falls back to
# `<project>/reference_files` and `<project>/results`.

# Where bundled FASTAs and GTFs live (downloaded by `install.sh` or
# `scripts/setup_references.sh`). For multi-user lab setups this can
# point at a shared read-only location.
export SHANNONPORE_REF_DIR=/path/to/your/reference_files

# Where pipeline outputs (bedgraphs, plots, run_summary.json) get
# written. Per-user / per-project — must be writable.
export SHANNONPORE_RESULTS_DIR=/path/to/your/results
