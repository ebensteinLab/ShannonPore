#!/usr/bin/env bash
# shannonpore — bash entry point that wraps the Python CLI.
#
# Works whether this script is invoked directly OR via a symlink in
# ~/.local/bin (which install.sh creates), because it resolves
# BASH_SOURCE[0] through any chain of symlinks before computing the
# repo location.
#
# Resolves the conda env via `mamba run` / `conda run` so the user
# never needs to `mamba activate`. Falls back to the system python3
# if no conda CLI / env is found.

set -euo pipefail

# Resolve this script's true location through any symlinks.
SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
    SCRIPT="$(readlink "$SCRIPT")"
    [[ "$SCRIPT" != /* ]] && SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
V4_DIR="$(cd -P "$(dirname "$SCRIPT")/.." && pwd)"

ENV_NAME="${SHANNONPORE_ENV_NAME:-shannonpore}"

# Prefer a conda-family CLI so we don't depend on the user's shell init.
for cli in micromamba mamba conda; do
    if command -v "$cli" >/dev/null 2>&1; then
        if "$cli" env list 2>/dev/null | awk '{print $1}' | grep -qx "$ENV_NAME"; then
            exec "$cli" run -n "$ENV_NAME" python -m src.cli "$@"
        fi
    fi
done

# Fallback: use whatever python3 is on PATH, from inside the project root.
cd "$V4_DIR"
exec python3 -m src.cli "$@"
